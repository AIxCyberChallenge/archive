-  memset(&async->thdata.hinfo, 0, sizeof(struct Curl_https_rrinfo));
-  async->thdata.hinfo.port = -1;
-  ares_query_dnsrec(async->thdata.channel,
-                    data->conn->host.name, ARES_CLASS_IN,
-                    ARES_REC_TYPE_HTTPS,
-                    Curl_dnsrec_done_cb, data, NULL);
