+  /* Also match ACCOUNT, ALTERNATIVE-TO-USER, USE_SSL and CCC options */
+  if(!nftpc || !cftpc ||
+     Curl_timestrcmp(nftpc->account, cftpc->account) ||
+     Curl_timestrcmp(nftpc->alternative_to_user,
+                     cftpc->alternative_to_user) ||
+     (nftpc->use_ssl != cftpc->use_ssl) ||
+     (nftpc->ccc != cftpc->ccc))
+    return FALSE;
+  return TRUE;
+}
