diff --git a/tests/unit/unit3211.c b/tests/unit/unit3211.c
new file mode 100644
index 000000000..c9c15ca6d
--- /dev/null
+++ b/tests/unit/unit3211.c
@@ -0,0 +1,153 @@
+/***************************************************************************
+ *                                  _   _ ____  _
+ *  Project                     ___| | | |  _ \| |
+ *                             / __| | | | |_) | |
+ *                            | (__| |_| |  _ <| |___
+ *                             \___|\___/|_| \_\_____|
